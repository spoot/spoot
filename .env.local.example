# Local credentials for the release script (scripts/publish.ts)
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# Cloudflare AI Gateway — used to call Gemini for version bump analysis
# Find your gateway URL in the Cloudflare dashboard under AI > AI Gateway
CF_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/YOUR_ACCOUNT_ID/YOUR_GATEWAY_NAME
CF_AI_GATEWAY_TOKEN=your-cf-ai-gateway-token

# npm auth is handled interactively locally (run `npm login` once before releasing)
# In CI, OIDC provenance publishing is used — no token needed.

# Optional: override the Gemini model (default: gemini-2.5-flash)
# MODEL=gemini-2.5-pro
