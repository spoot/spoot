# Local credentials for the release script (scripts/publish.ts)
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# Cloudflare AI Gateway — used to call Gemini for version bump analysis
# Find your gateway URL in the Cloudflare dashboard under AI > AI Gateway
CF_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/YOUR_ACCOUNT_ID/YOUR_GATEWAY_NAME
CF_AI_GATEWAY_TOKEN=your-cf-ai-gateway-token

# npm publish token — needs publish access to the @spoot scope
# Create at https://www.npmjs.com/settings/tokens (Automation token recommended)
NODE_AUTH_TOKEN=npm_your_token_here

# Optional: override the Gemini model (default: gemini-2.0-flash)
# MODEL=gemini-2.5-pro
